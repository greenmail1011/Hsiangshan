rules_version = '2';

// 香山國小分組積分系統：Firestore 規則（免登入版）
// 知道網址的人都能讀寫，但只能寫入這個系統用得到的欄位和合理的長度。
// 想改成只有老師登入才能用，請改貼 firestore-login.rules。

service cloud.firestore {
  match /databases/{database}/documents {

    function validStudent(d) {
      return d.keys().hasOnly(['cls', 'name', 'en', 'pts', 'absent', 'lead', 'grp', 'ord', 'hist'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 12
        && (!('cls' in d) || (d.cls is string && d.cls.size() <= 8))
        && (!('en' in d) || (d.en is string && d.en.size() <= 20))
        && d.pts is number
        && (!('grp' in d) || (d.grp is string && d.grp.size() <= 3))
        && (!('hist' in d) || (d.hist is list && d.hist.size() <= 40));
    }

    function validSettings(d) {
      return d.keys().hasOnly(['groupCount', 'method', 'names', 'reasons'])
        && d.groupCount is int && d.groupCount >= 2 && d.groupCount <= 8;
    }

    match /students/{id} {
      allow read: if true;
      allow create, update: if validStudent(request.resource.data);
      allow delete: if true;
    }

    match /settings/{id} {
      allow read: if true;
      allow create, update: if id == 'main' && validSettings(request.resource.data);
    }
  }
}
